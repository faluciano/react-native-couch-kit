{
  "name": "@couch-kit/runtime",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "description": "Transport-neutral authoritative game runtime for Couch Kit hosts",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/faluciano/react-native-couch-kit.git",
    "directory": "packages/runtime"
  },
  "homepage": "https://github.com/faluciano/react-native-couch-kit#readme",
  "keywords": [
    "couch-kit",
    "party-game",
    "game-runtime",
    "websocket",
    "webrtc"
  ],
  "main": "./dist/index.js",
  "types": "./lib/index.d.ts",
  "react-native": "./dist/index.js",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "react-native": {
        "types": "./lib/index.d.ts",
        "default": "./dist/index.js"
      },
      "types": "./lib/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "src",
    "dist",
    "lib",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target browser --external @couch-kit/core && bun build ./src/index.ts --outfile ./dist/index.cjs --target browser --format cjs --external @couch-kit/core && tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist lib"
  },
  "dependencies": {
    "@couch-kit/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^7.0.0"
  }
}
